          <mxGeometry x="65" y="415" width="790" height="375" as="geometry" />
        </mxCell>

        <!-- Subpaquete app/routers -->
        <mxCell id="sub-routers" value="&amp;lt;&amp;lt;package&amp;gt;&amp;gt; &lt;b&gt;app/routers/&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#2563eb;&quot;&gt;Controladores API REST&lt;/b&gt;&lt;br&gt;• Ingesta telemetría IoT y WS&lt;br&gt;• Autenticación y roles JWT&lt;br&gt;• Cobro de tickets y aforo&lt;br&gt;• Inventario y stock químico&lt;br&gt;• Auditoría de operaciones" style="shape=folder;tabWidth=110;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#2563eb;fillColor=#f1f5f9;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="475" width="225" height="150" as="geometry" />
        </mxCell>

        <!-- Subpaquete app/services -->
        <mxCell id="sub-services" value="&amp;lt;&amp;lt;package&amp;gt;&amp;gt; &lt;b&gt;app/services/&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1e293b;&quot;&gt;Lógica del Negocio&lt;/b&gt;&lt;br&gt;• Validación física de rangos (C3)&lt;br&gt;• Descarte de anómalos y logs (C5)&lt;br&gt;• Reglas normativas de agua&lt;br&gt;• Seguridad y Bcrypt hashing&lt;br&gt;• Emisión de alertas críticas" style="shape=folder;tabWidth=110;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#334155;fillColor=#f1f5f9;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
