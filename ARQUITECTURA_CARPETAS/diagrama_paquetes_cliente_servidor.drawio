        <mxCell id="sub-models" value="&amp;lt;&amp;lt;package&amp;gt;&amp;gt; &lt;b&gt;app/models/&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#059669;&quot;&gt;Entidades y ORM&lt;/b&gt;&lt;br&gt;• Schemas Pydantic (Validación)&lt;br&gt;• Modelos Declarativos SQLAlchemy&lt;br&gt;• Mapeo relacional ACID&lt;br&gt;• Tipado estricto de telemetría&lt;br&gt;• Integridad y claves foráneas" style="shape=folder;tabWidth=105;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#059669;fillColor=#f1f5f9;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
