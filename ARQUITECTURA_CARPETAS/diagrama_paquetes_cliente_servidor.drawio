        <mxCell id="hdr-txt" value="&lt;b style=&quot;font-size:17px; color:#0f172a;&quot;&gt;DIAGRAMA DE PAQUETES UML · ARQUITECTURA CLIENTE - SERVIDOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Organización Modular del Sistema: Capa Cliente (/frontend), Capa Servidor (/backend, /iot, /lstm) y Capa Persistencia (PostgreSQL)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1350" height="60" as="geometry" />
        </mxCell>

