        </mxCell>

        <mxCell id="tb-inv" value="&lt;b&gt;inventario_quimicos&lt;/b&gt;&lt;br&gt;• Stock de cloro y reguladores&lt;br&gt;• Umbrales de abastecimiento&lt;br&gt;&lt;i&gt;(Dosis aplicadas)&lt;/i&gt;" style="shape=folder;tabWidth=110;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#16a34a;fillColor=#ffffff;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="875" width="240" height="90" as="geometry" />
        </mxCell>

