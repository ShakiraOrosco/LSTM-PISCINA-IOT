        <!-- ========================================== -->
        <mxCell id="tier-db" value="&lt;b&gt;CAPA PERSISTENCIA (DATABASE TIER - POSTGRESQL 15 ACID)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#16a34a;fillColor=#f0fdf4;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;fontSize=11.5;fontColor=#15803d;" vertex="1" parent="1">
