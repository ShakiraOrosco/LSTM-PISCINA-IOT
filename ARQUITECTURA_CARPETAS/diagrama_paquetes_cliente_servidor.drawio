        </mxCell>

        <mxCell id="tb-afo" value="&lt;b&gt;aforo_registros &amp;amp; caja&lt;/b&gt;&lt;br&gt;• Conteo en vivo de personas&lt;br&gt;• Entradas, salidas y montos&lt;br&gt;&lt;i&gt;(Tickets y capacidad)&lt;/i&gt;" style="shape=folder;tabWidth=120;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#16a34a;fillColor=#ffffff;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
