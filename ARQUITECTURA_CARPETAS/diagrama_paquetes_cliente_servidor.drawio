        </mxCell>

        <mxCell id="tb-usr" value="&lt;b&gt;usuarios &amp;amp; roles&lt;/b&gt;&lt;br&gt;• Credenciales y hash Bcrypt&lt;br&gt;• Admin, Operador, Cajero&lt;br&gt;&lt;i&gt;(Autenticación y sesión)&lt;/i&gt;" style="shape=folder;tabWidth=100;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#16a34a;fillColor=#ffffff;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
