        <mxCell id="tb-med" value="&lt;b&gt;mediciones_sensores&lt;/b&gt;&lt;br&gt;• pH, turbidez, temperatura&lt;br&gt;• Timestamp y estado válido&lt;br&gt;&lt;i&gt;(Histórico telemetría)&lt;/i&gt;" style="shape=folder;tabWidth=110;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#16a34a;fillColor=#ffffff;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
