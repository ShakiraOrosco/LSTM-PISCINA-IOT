        <!-- Módulo Visión YOLOv8 y Configuración -->
        <mxCell id="box-yolo-cfg" value="&lt;b&gt;Módulo de Visión Artificial (Aforo):&lt;/b&gt; detector_camara.py + Modelos yolov8n.pt / yolov8s.pt (Conteo en tiempo real)&lt;br&gt;&lt;b&gt;Módulos Base de Inicialización:&lt;/b&gt; main.py (FastAPI App &amp;amp; CORS) | db.py (Pool SQLAlchemy) | config.py (Variables de entorno)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.2;strokeColor=#64748b;fillColor=#f8fafc;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="85" y="650" width="745" height="110" as="geometry" />
        </mxCell>

        <!-- PAQUETE: /iot (UBICADO DENTRO DEL SERVIDOR) -->
        <mxCell id="pkg-iot" value="&amp;lt;&amp;lt;package&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;/iot&lt;/b&gt; (Subsistema de Telemetría IoT)" style="shape=folder;fontStyle=1;tabWidth=160;tabHeight=25;tabPosition=left;html=1;boundedLbl=1;strokeWidth=2;strokeColor=#059669;fillColor=#ffffff;verticalAlign=top;spacingTop=28;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="880" y="415" width="505" height="175" as="geometry" />
        </mxCell>

        <mxCell id="sub-esp" value="&amp;lt;&amp;lt;subpackage&amp;gt;&amp;gt; &lt;b&gt;esp32/&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#059669;&quot;&gt;Firmware de Sensores&lt;/b&gt;&lt;br&gt;• Muestreo cíclico (pH, turbidez, temp)&lt;br&gt;• Calibración y filtrado analógico&lt;br&gt;• Transmisión segura WiFi al backend" style="shape=folder;tabWidth=90;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#059669;fillColor=#f0fdf4;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="475" width="225" height="95" as="geometry" />
        </mxCell>

        <mxCell id="sub-sim" value="&amp;lt;&amp;lt;subpackage&amp;gt;&amp;gt; &lt;b&gt;simulador/&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1e293b;&quot;&gt;simulador_api.py&lt;/b&gt;&lt;br&gt;• Emulación sintética de telemetría&lt;br&gt;• Inyección de paquetes corruptos&lt;br&gt;• Pruebas de estrés y contingencia" style="shape=folder;tabWidth=95;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#64748b;fillColor=#f8fafc;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="475" width="225" height="95" as="geometry" />
        </mxCell>

        <!-- PAQUETE: /lstm (UBICADO DENTRO DEL SERVIDOR) -->
        <mxCell id="pkg-lstm" value="&amp;lt;&amp;lt;package&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;/lstm&lt;/b&gt; (Red Neuronal Predictiva Dosificación)" style="shape=folder;fontStyle=1;tabWidth=170;tabHeight=25;tabPosition=left;html=1;boundedLbl=1;strokeWidth=2;strokeColor=#7c3aed;fillColor=#ffffff;verticalAlign=top;spacingTop=28;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="880" y="615" width="505" height="175" as="geometry" />
        </mxCell>

        <mxCell id="sub-lstmsrc" value="&amp;lt;&amp;lt;package&amp;gt;&amp;gt; &lt;b&gt;lstm/src/&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#581c87;&quot;&gt;Inferencia y Predicción&lt;/b&gt;&lt;br&gt;• predictor.py (Inferencia online)&lt;br&gt;• model_trainer.py (Entrenamiento)&lt;br&gt;• preprocessor.py (Normalización)" style="shape=folder;tabWidth=85;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#7c3aed;fillColor=#faf5ff;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="675" width="225" height="95" as="geometry" />
        </mxCell>

        <mxCell id="sub-lstmmod" value="&amp;lt;&amp;lt;package&amp;gt;&amp;gt; &lt;b&gt;models/ &amp;amp; data/&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#581c87;&quot;&gt;Pesos y Series de Datos&lt;/b&gt;&lt;br&gt;• model_best.keras (Red LSTM)&lt;br&gt;• scaler.pkl (Escalador MinMax)&lt;br&gt;• Datasets históricos de calidad" style="shape=folder;tabWidth=110;tabHeight=18;html=1;strokeWidth=1.5;strokeColor=#7c3aed;fillColor=#faf5ff;fontSize=10;verticalAlign=top;spacingTop=20;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="675" width="225" height="95" as="geometry" />
        </mxCell>

