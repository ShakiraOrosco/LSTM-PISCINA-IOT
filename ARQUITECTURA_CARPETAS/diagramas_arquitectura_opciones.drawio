        <!-- HEADER -->
        <mxCell id="cmp-hdr" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4338ca;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="840" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cmp-hdrtxt" value="&lt;b style=&quot;font-size:16px; color:#312e81;&quot;&gt;DIAGRAMA DE COMPONENTES UML 2.5 (COMPONENT DIAGRAM)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px; color:#475569;&quot;&gt;Estructura Modular, Interfaces Provistas/Requeridas (Puertos) y Conexiones entre Subsistemas&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="23" width="820" height="55" as="geometry" />
        </mxCell>

        <!-- COMPONENTE 1: FRONTEND -->
