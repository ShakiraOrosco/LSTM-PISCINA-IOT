        <mxCell id="f-j2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeWidth=1.8;strokeColor=#222222;" edge="1" parent="1" source="act9b" target="join-bar">
