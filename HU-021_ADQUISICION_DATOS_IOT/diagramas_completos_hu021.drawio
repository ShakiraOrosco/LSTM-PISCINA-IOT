<diagram id="act-hu021" name="2. Diagrama de Actividades (HU-021)">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titulo -->
        <mxCell id="act-title" value="DIAGRAMA DE ACTIVIDADES: ADQUISICIÓN Y TRANSMISIÓN IOT (UML 2.5 - HU-021)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="980" height="30" as="geometry" />
        </mxCell>

        <!-- SWIMLANES / CALLES DE RESPONSABILIDAD -->
        <mxCell id="lane-1" value="SENSORES FÍSICOS (AGUA)" style="swimlane;startSize=38;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;fontStyle=1;strokeColor=#222222;fillColor=#f8fafc;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="220" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="lane-2" value="NODO IOT (ESP32)" style="swimlane;startSize=38;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;fontStyle=1;strokeColor=#222222;fillColor=#f8fafc;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="250" y="55" width="250" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="lane-3" value="BACKEND FASTAPI &amp; VALIDADOR" style="swimlane;startSize=38;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;fontStyle=1;strokeColor=#222222;fillColor=#f8fafc;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="500" y="55" width="260" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="lane-4" value="BD POSTGRESQL &amp; DASHBOARD" style="swimlane;startSize=38;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;fontStyle=1;strokeColor=#222222;fillColor=#f8fafc;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="760" y="55" width="250" height="1160" as="geometry" />
        </mxCell>

        <!-- NODO INICIAL -->
        <mxCell id="init-node" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#222222;strokeColor=none;" vertex="1" parent="lane-2">
          <mxGeometry x="110" y="60" width="26" height="26" as="geometry" />
        </mxCell>

        <!-- ACTIVIDAD 1: Disparo Timer -->
        <mxCell id="act1" value="Disparar temporizador&lt;br&gt;periódico de muestreo" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="lane-2">
          <mxGeometry x="35" y="115" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ACTIVIDAD 2: Sensores emiten senales -->
        <mxCell id="act2" value="Emitir voltajes analógicos&lt;br&gt;y pulsos OneWire (pH, Turb, Temp)" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="lane-1">
          <mxGeometry x="20" y="190" width="180" height="54" as="geometry" />
        </mxCell>

        <!-- ACTIVIDAD 3: Leer canales ADC -->
        <mxCell id="act3" value="Leer canales ADC y OneWire;&lt;br&gt;convertir a unidades físicas" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="lane-2">
          <mxGeometry x="30" y="270" width="190" height="54" as="geometry" />
        </mxCell>

        <!-- ACTIVIDAD 4: JSON -->
        <mxCell id="act4" value="Estructurar payload JSON&lt;br&gt;con timestamp e ID de nodo" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="lane-2">
          <mxGeometry x="30" y="350" width="190" height="54" as="geometry" />
        </mxCell>

        <!-- ACTIVIDAD 5: Backend recibe -->
        <mxCell id="act5" value="Recibir paquete HTTP POST&lt;br&gt;y analizar estructura Pydantic" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="lane-3">
          <mxGeometry x="35" y="420" width="190" height="54" as="geometry" />
        </mxCell>

        <!-- DECISION 1: ¿Lectura valida? -->
        <mxCell id="dec1" value="¿Lectura válida&lt;br&gt;y en rangos físicos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1" parent="lane-3">
          <mxGeometry x="45" y="510" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- RAMA ERROR: Descarte -->
        <mxCell id="act6a" value="Descartar valor anómalo&lt;br&gt;y generar aviso de error" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b91c1c;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#b91c1c;" vertex="1" parent="lane-2">
          <mxGeometry x="35" y="520" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="act7a" value="Guardar aviso de incidencia&lt;br&gt;en tabla iot_error_logs" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b91c1c;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#b91c1c;" vertex="1" parent="lane-4">
          <mxGeometry x="35" y="580" width="180" height="50" as="geometry" />
