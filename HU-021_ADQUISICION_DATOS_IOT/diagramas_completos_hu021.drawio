        <mxCell id="final-lbl" value="Apagado / Mant." style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#475569;" vertex="1" parent="lane-2">
          <mxGeometry x="75" y="1015" width="100" height="20" as="geometry" />
