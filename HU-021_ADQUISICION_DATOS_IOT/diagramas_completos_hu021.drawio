        <mxCell id="f-log" value="Log auditoría" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#b91c1c;fontSize=10;fontStyle=1;fontColor=#b91c1c;" edge="1" parent="1" source="act6a" target="act7a">
