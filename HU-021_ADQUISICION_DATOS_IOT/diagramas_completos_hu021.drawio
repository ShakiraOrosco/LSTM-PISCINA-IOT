          <mxGeometry x="35" y="680" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="act9b" value="Emitir evento WebSocket:&lt;br&gt;actualizar tarjetas de Dashboard" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1e40af;" vertex="1" parent="lane-4">
