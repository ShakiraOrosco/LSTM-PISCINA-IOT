        <!-- CONECTORES (FLECHAS DE FLUJO) -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#222222;" edge="1" parent="1" source="init-node" target="act1">
