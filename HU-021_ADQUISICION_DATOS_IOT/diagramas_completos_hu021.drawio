        <mxCell id="ftr-txt" value="&lt;b&gt;COBERTURA DE CRITERIOS DE ACEPTACIÓN HU-021:&lt;/b&gt; &lt;b&gt;C1:&lt;/b&gt; Lecturas periódicas (Msgs 1-2) | &lt;b&gt;C2:&lt;/b&gt; Transmisión inalámbrica segura (Msg 5) | &lt;b&gt;C3:&lt;/b&gt; Validación de rangos físicos (Msgs 6-7) | &lt;b&gt;C4:&lt;/b&gt; Persistencia y Dashboard en tiempo real (Msgs 10b, 12b, 13b) | &lt;b&gt;C5:&lt;/b&gt; Descarte y log de error (Msgs 9a, 10a, 12a)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
