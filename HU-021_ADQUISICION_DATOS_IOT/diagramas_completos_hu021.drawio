        <mxCell id="sec-hdr-txt" value="&lt;b style=&quot;font-size:17px; color:#1e3a8a;&quot;&gt;DIAGRAMA DE SECUENCIA UML (SEQUENCE DIAGRAM) · HU-021&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Adquisición y Recepción Inalámbrica de Datos IoT desde ESP32 · RF-21 · Sistema Piscina Playa Azul (8 SP - Alta)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
