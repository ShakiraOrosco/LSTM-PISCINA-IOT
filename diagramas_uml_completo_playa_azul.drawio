        <mxCell id="dep-yolo-details" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#ea580c;fillColor=#ffffff;fontSize=10;fontColor=#7c2d12;align=left;spacingLeft=10;" value="&lt;b&gt;Motor de Visión YOLOv8 &amp;amp; Geocerca:&lt;/b&gt;&#xa;• &lt;b&gt;OpenCV VideoCapture&lt;/b&gt;: Ingesta continua de stream MJPEG&#xa;• &lt;b&gt;Modelo YOLOv8&lt;/b&gt; (&lt;i&gt;yolov8s.pt / yolov8n.pt&lt;/i&gt;): Detección clase persona&#xa;• &lt;b&gt;Filtro Geocerca ROI&lt;/b&gt; (&lt;i&gt;camera_roi_config.json&lt;/i&gt;): Polígono piscina&#xa;• Conteo de personas dentro del área de agua y sincronización con API" vertex="1">
          <mxGeometry height="105" width="460" x="570" y="550" as="geometry" />
        </mxCell>
        <mxCell id="dep-art-lstm" parent="1" style="shape=module;align=left;spacingLeft=34;whiteSpace=wrap;html=1;strokeWidth=1.5;strokeColor=#4338ca;fillColor=#eef2ff;fontSize=11;fontColor=#312e81;fontStyle=1;verticalAlign=top;spacingTop=6;" value="«artifact»&#xa;&lt;b&gt;Motor Predictivo LSTM de Dosificación&lt;/b&gt; (lstm/src/)&#xa;Red Neuronal Recurrente Deep Learning" vertex="1">
