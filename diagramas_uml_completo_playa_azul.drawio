        <!-- Enlaces Backend <-> IA -->
        <mxCell id="cmp-e-bk-yolo" value="«call» POST /aforo-camara" style="endArrow=block;endFill=1;dashed=1;html=1;strokeColor=#ea580c;fontSize=10;fontColor=#c2410c;" edge="1" parent="1" source="cmp-ia-yolo" target="cmp-bk-router"><mxGeometry relative="1" as="geometry" /></mxCell>
