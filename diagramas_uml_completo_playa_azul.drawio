          <mxGeometry x="540" y="845" width="670" height="265" as="geometry" />
        </mxCell>

        <!-- WORKER YOLO -->
        <mxCell id="cmp-ia-yolo" value="«component»&#xa;&lt;b&gt;Worker YOLOv8 (detector_camara.py)&lt;/b&gt;&#xa;• Inferencia &lt;i&gt;yolov8s.pt&lt;/i&gt; (Detección Personas)&#xa;• Geocerca Poligonal (&lt;i&gt;camera_roi_config.json&lt;/i&gt;)&#xa;• Captura OpenCV VideoCapture" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;strokeWidth=1.5;strokeColor=#ea580c;fillColor=#fff7ed;fontSize=10;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="565" y="890" width="310" height="95" as="geometry" />
        </mxCell>

        <!-- MOTOR PREDICTIVO LSTM -->
        <mxCell id="cmp-ia-lstm" value="«component»&#xa;&lt;b&gt;Motor Predictivo LSTM (lstm/src)&lt;/b&gt;&#xa;• TensorFlow / Keras Recurrent Model&#xa;• Scaler &amp;amp; Preprocesamiento de Series Temporales&#xa;• Cálculo Químico: Sulfato Al, Sulfato Cu, Cloro" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;strokeWidth=1.5;strokeColor=#4338ca;fillColor=#eef2ff;fontSize=10;fontColor=#312e81;" vertex="1" parent="1">
