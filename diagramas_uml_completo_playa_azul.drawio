        <mxCell id="dep-fastapi-routers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#0d9488;fillColor=#ffffff;fontSize=10;fontColor=#134e4a;align=left;spacingLeft=10;" value="&lt;b&gt;Módulos y Routers REST API:&lt;/b&gt;&#xa;• &lt;b&gt;/auth&lt;/b&gt;: Autenticación, JWT tokens, bcrypt hash&#xa;• &lt;b&gt;/lecturas&lt;/b&gt;: Recepción de telemetría IoT de sensores&#xa;• &lt;b&gt;/api/v1/aforo-camara&lt;/b&gt;: Registro y consulta de bañistas detectados&#xa;• &lt;b&gt;/caja &amp;amp; /inventario&lt;/b&gt;: Gestión de aforo y stock de químicos&#xa;• &lt;b&gt;/auditoria&lt;/b&gt;: Trazabilidad de operaciones de usuarios" vertex="1">
          <mxGeometry height="115" width="460" x="570" y="340" as="geometry" />
