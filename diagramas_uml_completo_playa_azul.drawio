        <mxCell id="cmp-iot-esp32" value="«component»&#xa;&lt;b&gt;Firmware Sensores (ESP32)&lt;/b&gt;&#xa;Módulos: &lt;i&gt;pool_sensors.py&lt;/i&gt;, &lt;i&gt;wifi_manager.py&lt;/i&gt;&#xa;Lectura ADC de pH, Turbidez y Temperatura" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;strokeWidth=1.5;strokeColor=#0284c7;fillColor=#e0f2fe;fontSize=10;fontColor=#0369a1;" vertex="1" parent="1">
