        </mxCell>
        <mxCell id="dep-leg-note" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#475569;" value="&lt;b&gt;Observaciones de Arquitectura:&lt;/b&gt; El sistema implementa una arquitectura híbrida IoT + Edge Computing + Cloud DB. Los microcontroladores transmiten en tiempo real por Wi-Fi hacia el Servidor Central donde se realiza el procesamiento pesado de visión (YOLOv8) e inferencia neuronal (LSTM), persistiendo en PostgreSQL y publicando servicios REST hacia el cliente Web React." vertex="1">
          <mxGeometry height="50" width="680" x="960" y="1002" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
