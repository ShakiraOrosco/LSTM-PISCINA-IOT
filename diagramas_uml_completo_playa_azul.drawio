        <!-- ========================================== -->
        <!-- SUBSISTEMA 4: IOT & SENSORES               -->
        <!-- ========================================== -->
        <mxCell id="cmp-sub-iot" value="&lt;b&gt;«subsystem» Dispositivos IoT (Firmware Planta)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="40" y="845" width="460" height="265" as="geometry" />
